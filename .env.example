# vault
VAULT_PATH=~/meridian/vault

# The port comes from the shell, not from here:
#   PORT=3300 npm run dev

# BambooHR (read only)
# BAMBOOHR_SUBDOMAIN=
# BAMBOOHR_API_KEY=
# BAMBOOHR_MANAGER_EMPLOYEE_ID=
# BAMBOOHR_MAX_AGE=3600

# Where your company keeps pay. The setup wizard finds this and writes it: it
# asks BambooHR which tables exist and picks the one that answers for you. These
# are here for the case it cannot — a table whose field names are not the ones
# below, or a key that cannot read meta/tables.

# BAMBOOHR_COMP_TABLE=customAdditionalOverallCompensation
# BAMBOOHR_COMP_DATE_FIELD=customDate1
# BAMBOOHR_COMP_AMOUNT_FIELD=customTotal1
# BAMBOOHR_COMP_GROSS_FIELD=customGrosssalary

# Google Calendar (read only, revalidated every load). Settings → Connect takes
# all four, checks them against Google together, and writes them only if the
# account can actually read the calendar you named. The client is one you create
# in your own Google Cloud project; the refresh token is minted for it with the
# calendar.readonly scope.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_ID=
# GOOGLE_REFRESH_TOKEN=

# GitHub (read only)
# GITHUB_TOKEN=
# GITHUB_LOGIN=
# GITHUB_REPOS=

# Appearance: light, dark or system. Written by the Settings screen. Light is
# what an absent or unreadable value means; system hands the choice to the Mac.
# MERIDIAN_THEME=light
