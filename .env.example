# vault
VAULT_PATH=~/meridian/vault

# The port comes from the shell, not from here:
#   PORT=3300 npm run dev

# BambooHR (read only)
# BAMBOOHR_SUBDOMAIN=
# BAMBOOHR_API_KEY=
# BAMBOOHR_MANAGER_EMPLOYEE_ID=
# BAMBOOHR_MAX_AGE=3600

# Where your company keeps pay. The default is BambooHR's standard `compensation`
# table, which is what most companies use. If yours is empty for everyone, pay
# lives in a custom table — find its name and its fields under meta/tables and
# meta/fields on your own subdomain, and set them here.
# BAMBOOHR_COMP_TABLE=customAdditionalOverallCompensation
# BAMBOOHR_COMP_DATE_FIELD=customDate1
# BAMBOOHR_COMP_AMOUNT_FIELD=customTotal1
# BAMBOOHR_COMP_GROSS_FIELD=customGrosssalary

# Google Calendar (read only, revalidated every load)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_ID=
# GOOGLE_REFRESH_TOKEN=

# GitHub (read only)
# GITHUB_TOKEN=
# GITHUB_LOGIN=
# GITHUB_REPOS=

# Appearance: light, dark or system. Written by the Settings screen. Light is
# what an absent or unreadable value means; system hands the choice to the Mac.
# MERIDIAN_THEME=light
